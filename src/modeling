import React, { useEffect, useRef, useState } from 'react';
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { TextPlugin } from 'gsap/TextPlugin';
import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

// Register GSAP plugins
if (typeof window !== 'undefined') {
  gsap.registerPlugin(ScrollTrigger, TextPlugin, MorphSVGPlugin);
}

const ModelingAgencyLanding = () => {
  // Refs
  const heroRef = useRef(null);
  const logoRef = useRef(null);
  const navRef = useRef(null);
  const shapeContainerRef = useRef(null);
  const modelsGridRef = useRef(null);
  const contactFormRef = useRef(null);
  const popupRef = useRef(null);
  
  // Shape refs
  const shapesRef = useRef([]);
  const floatingShapesRef = useRef([]);
  
  // State
  const [activeModel, setActiveModel] = useState(null);
  const [isPopupOpen, setIsPopupOpen] = useState(false);
  const [menuOpen, setMenuOpen] = useState(false);

  // Models data
  const models = [
    { id: 1, name: "ALEXA", category: "Fashion", color: "#FF6B8B", video: "https://assets.mixkit.co/videos/preview/mixkit-fashion-model-in-a-modern-studio-39871-large.mp4" },
    { id: 2, name: "MARCUS", category: "Runway", color: "#4ECDC4", video: "https://assets.mixkit.co/videos/preview/mixkit-man-doing-model-poses-on-a-runway-39872-large.mp4" },
    { id: 3, name: "SOPHIA", category: "Commercial", color: "#45B7D1", video: "https://assets.mixkit.co/videos/preview/mixkit-woman-model-in-a-photo-studio-39874-large.mp4" },
    { id: 4, name: "JULIAN", category: "Editorial", color: "#96CEB4", video: "https://assets.mixkit.co/videos/preview/mixkit-man-model-in-studio-39873-large.mp4" },
    { id: 5, name: "ISABELLA", category: "High Fashion", color: "#FFEAA7", video: "https://assets.mixkit.co/videos/preview/mixkit-woman-model-posing-in-a-photo-studio-39875-large.mp4" },
    { id: 6, name: "LEO", category: "Lifestyle", color: "#DDA0DD", video: "https://assets.mixkit.co/videos/preview/mixkit-man-doing-model-poses-39876-large.mp4" },
  ];

  // Initialize refs
  shapesRef.current = [];
  floatingShapesRef.current = [];

  // Add to refs functions
  const addShapeRef = (el) => el && shapesRef.current.push(el);
  const addFloatingShapeRef = (el) => el && floatingShapesRef.current.push(el);

  useEffect(() => {
    // ============================================
    // PART 1: INITIAL LOAD ANIMATIONS
    // ============================================
    
    // Animate logo on load
    gsap.fromTo(logoRef.current,
      { 
        scale: 0,
        rotation: -180,
        opacity: 0 
      },
      {
        scale: 1,
        rotation: 0,
        opacity: 1,
        duration: 1.5,
        ease: "elastic.out(1, 0.5)"
      }
    );

    // Animate navigation
    gsap.fromTo(".nav-item",
      { y: -50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.1,
        delay: 0.5
      }
    );

    // Hero text typing animation
    gsap.to(".hero-title", {
      text: "ELITE MODEL MANAGEMENT",
      duration: 2,
      ease: "none",
      delay: 0.8
    });

    // Animate hero subtitle
    gsap.fromTo(".hero-subtitle",
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        delay: 1.5
      }
    );

    // ============================================
    // PART 2: FLOATING SHAPES ANIMATION
    // ============================================
    
    // Create floating shapes animation
    floatingShapesRef.current.forEach((shape, i) => {
      const tl = gsap.timeline({ repeat: -1, yoyo: true });
      
      tl.to(shape, {
        y: `+=${50 + i * 10}`,
        rotation: 360,
        duration: 3 + i,
        ease: "sine.inOut"
      })
      .to(shape, {
        x: `+=${30 + i * 5}`,
        duration: 2 + i,
        ease: "power1.inOut"
      }, "-=1.5");
    });

    // ============================================
    // PART 3: SCROLL-BASED ANIMATIONS
    // ============================================
    
    // Hero section parallax
    gsap.to(heroRef.current, {
      y: -200,
      ease: "none",
      scrollTrigger: {
        trigger: heroRef.current,
        start: "top top",
        end: "bottom top",
        scrub: 1
      }
    });

    // Animate models grid on scroll
    gsap.fromTo(".model-card",
      { 
        y: 100,
        opacity: 0,
        scale: 0.8 
      },
      {
        y: 0,
        opacity: 1,
        scale: 1,
        duration: 0.8,
        stagger: 0.15,
        ease: "back.out(1.2)",
        scrollTrigger: {
          trigger: modelsGridRef.current,
          start: "top 80%",
          toggleActions: "play none none reverse"
        }
      }
    );

    // Animate stats counter
    gsap.to(".stat-number", {
      innerText: function(index, target) {
        const value = target.getAttribute("data-value");
        return value;
      },
      duration: 2,
      snap: { innerText: 1 },
      stagger: 0.5,
      scrollTrigger: {
        trigger: ".stats-section",
        start: "top 70%",
        toggleActions: "play none none none"
      }
    });

    // Text reveal animation
    gsap.utils.toArray(".reveal-text").forEach(text => {
      gsap.fromTo(text,
        { 
          y: 100,
          opacity: 0,
          clipPath: "polygon(0 0, 100% 0, 100% 0, 0 0)" 
        },
        {
          y: 0,
          opacity: 1,
          clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
          duration: 1.5,
          ease: "power3.out",
          scrollTrigger: {
            trigger: text,
            start: "top 85%"
          }
        }
      );
    });

    // ============================================
    // PART 4: INTERACTIVE SHAPE MORPHING
    // ============================================
    
    shapesRef.current.forEach((shape, i) => {
      shape.addEventListener("mouseenter", () => {
        gsap.to(shape, {
          morphSVG: i % 2 === 0 
            ? "M0,0 L100,0 L50,100 Z"  // Triangle
            : "M50,0 C77.6,0 100,22.4 100,50 C100,77.6 77.6,100 50,100 C22.4,100 0,77.6 0,50 C0,22.4 22.4,0 50,0 Z", // Circle
          duration: 0.5,
          fill: models[i % models.length].color
        });
      });

      shape.addEventListener("mouseleave", () => {
        gsap.to(shape, {
          morphSVG: "M0,0 L100,0 L100,100 L0,100 Z", // Back to square
          duration: 0.5,
          fill: "#ffffff"
        });
      });
    });

    // ============================================
    // PART 5: INTERSECTION OBSERVER EFFECTS
    // ============================================
    
    // Create intersection observers for video play
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target;
        if (entry.isIntersecting) {
          video.play();
          gsap.to(video, { opacity: 1, duration: 0.5 });
        } else {
          video.pause();
          gsap.to(video, { opacity: 0.3, duration: 0.5 });
        }
      });
    }, { threshold: 0.5 });

    // Observe all model videos
    document.querySelectorAll(".model-video").forEach(video => {
      videoObserver.observe(video);
    });

    // ============================================
    // PART 6: SCROLL PROGRESS INDICATOR
    // ============================================
    
    gsap.to(".progress-bar", {
      width: "100%",
      ease: "none",
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.5
      }
    });

    // ============================================
    // PART 7: SMOOTH SCROLL FOR NAV LINKS
    // ============================================
    
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          gsap.to(window, {
            duration: 1.5,
            scrollTo: { y: target, offsetY: 80 },
            ease: "power3.inOut"
          });
        }
      });
    });

    // Cleanup
    return () => {
      ScrollTrigger.getAll().forEach(trigger => trigger.kill());
      gsap.killTweensOf("*");
    };
  }, []);

  // ============================================
  // POPUP FUNCTIONS
  // ============================================
  
  const openPopup = (model) => {
    setActiveModel(model);
    setIsPopupOpen(true);
    
    // Animate popup open
    gsap.fromTo(popupRef.current,
      { 
        scale: 0.8,
        opacity: 0,
        y: 50 
      },
      {
        scale: 1,
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "back.out(1.2)"
      }
    );
  };

  const closePopup = () => {
    // Animate popup close
    gsap.to(popupRef.current, {
      scale: 0.8,
      opacity: 0,
      y: 50,
      duration: 0.3,
      ease: "power2.in",
      onComplete: () => {
        setIsPopupOpen(false);
        setActiveModel(null);
      }
    });
  };

  // ============================================
  // MENU TOGGLE
  // ============================================
  
  const toggleMenu = () => {
    setMenuOpen(!menuOpen);
    
    if (!menuOpen) {
      gsap.to(".mobile-menu", {
        x: 0,
        duration: 0.5,
        ease: "power3.out"
      });
      gsap.to(".menu-item", {
        y: 0,
        opacity: 1,
        stagger: 0.1,
        delay: 0.2
      });
    } else {
      gsap.to(".mobile-menu", {
        x: "100%",
        duration: 0.3,
        ease: "power2.in"
      });
    }
  };

  // ============================================
  // CURSOR FOLLOW EFFECT
  // ============================================
  
  useEffect(() => {
    const cursor = document.querySelector('.custom-cursor');
    const onMouseMove = (e) => {
      gsap.to(cursor, {
        x: e.clientX,
        y: e.clientY,
        duration: 0.1,
        ease: "power2.out"
      });
    };
    
    document.addEventListener('mousemove', onMouseMove);
    return () => document.removeEventListener('mousemove', onMouseMove);
  }, []);

  return (
    <div className="landing-page">
      {/* Custom Cursor */}
      <div className="custom-cursor" style={{
        position: 'fixed',
        width: '20px',
        height: '20px',
        border: '2px solid white',
        borderRadius: '50%',
        pointerEvents: 'none',
        zIndex: 9999,
        mixBlendMode: 'difference'
      }} />
      
      {/* Progress Bar */}
      <div className="progress-bar" style={{
        position: 'fixed',
        top: 0,
        left: 0,
        height: '3px',
        width: '0%',
        background: 'linear-gradient(90deg, #FF6B8B, #4ECDC4)',
        zIndex: 9998
      }} />

      {/* Navigation */}
      <nav ref={navRef} style={{
        position: 'fixed',
        top: 0,
        width: '100%',
        padding: '20px 40px',
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center',
        zIndex: 100,
        background: 'rgba(10, 10, 20, 0.9)',
        backdropFilter: 'blur(10px)'
      }}>
        <div ref={logoRef} style={{
          fontSize: '24px',
          fontWeight: 'bold',
          color: 'white',
          fontFamily: 'monospace',
          letterSpacing: '2px'
        }}>
          ELEVATE
        </div>
        
        <div style={{ display: 'flex', gap: '40px' }}>
          {['Models', 'Services', 'About', 'Contact'].map((item, i) => (
            <a key={i} href={`#${item.toLowerCase()}`} className="nav-item" style={{
              color: 'white',
              textDecoration: 'none',
              fontFamily: 'sans-serif',
              fontSize: '14px',
              letterSpacing: '1px',
              opacity: 0
            }}>
              {item}
            </a>
          ))}
        </div>
        
        <button onClick={toggleMenu} style={{
          background: 'none',
          border: 'none',
          color: 'white',
          fontSize: '24px',
          cursor: 'pointer',
          display: 'none'
        }}>
          ☰
        </button>
      </nav>

      {/* Mobile Menu */}
      <div className="mobile-menu" style={{
        position: 'fixed',
        top: 0,
        right: '-100%',
        width: '300px',
        height: '100vh',
        background: 'rgba(10, 10, 20, 0.95)',
        zIndex: 999,
        padding: '100px 40px',
        backdropFilter: 'blur(20px)'
      }}>
        {['Models', 'Services', 'About', 'Contact'].map((item, i) => (
          <a key={i} href={`#${item.toLowerCase()}`} className="menu-item" style={{
            display: 'block',
            color: 'white',
            fontSize: '24px',
            marginBottom: '30px',
            textDecoration: 'none',
            opacity: 0,
            transform: 'translateY(20px)'
          }}>
            {item}
          </a>
        ))}
      </div>

      {/* Hero Section */}
      <section ref={heroRef} style={{
        height: '100vh',
        background: 'linear-gradient(135deg, #0a0a14 0%, #1a1a2e 100%)',
        position: 'relative',
        overflow: 'hidden',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center'
      }}>
        {/* Floating Shapes */}
        <div ref={shapeContainerRef} style={{ position: 'absolute', inset: 0 }}>
          {[...Array(15)].map((_, i) => (
            <div
              key={i}
              ref={addFloatingShapeRef}
              style={{
                position: 'absolute',
                width: `${20 + i * 5}px`,
                height: `${20 + i * 5}px`,
                background: models[i % models.length].color,
                opacity: 0.1,
                borderRadius: i % 3 === 0 ? '50%' : '0%',
                left: `${Math.random() * 100}%`,
                top: `${Math.random() * 100}%`,
                filter: 'blur(1px)'
              }}
            />
          ))}
        </div>

        {/* Hero Content */}
        <div style={{ textAlign: 'center', zIndex: 10 }}>
          <h1 className="hero-title" style={{
            fontSize: 'clamp(3rem, 8vw, 8rem)',
            fontWeight: '900',
            color: 'white',
            marginBottom: '20px',
            fontFamily: 'sans-serif',
            letterSpacing: '-2px'
          }}></h1>
          
          <p className="hero-subtitle" style={{
            fontSize: '1.2rem',
            color: 'rgba(255, 255, 255, 0.7)',
            marginBottom: '40px',
            opacity: 0
          }}>
            Redefining beauty standards with elite talent
          </p>
          
          <button onClick={() => openPopup(models[0])} style={{
            padding: '15px 40px',
            background: 'linear-gradient(45deg, #FF6B8B, #4ECDC4)',
            border: 'none',
            color: 'white',
            fontSize: '16px',
            fontWeight: 'bold',
            borderRadius: '30px',
            cursor: 'pointer',
            letterSpacing: '1px'
          }}>
            DISCOVER MODELS
          </button>
        </div>

        {/* Scroll Indicator */}
        <div style={{
          position: 'absolute',
          bottom: '40px',
          left: '50%',
          transform: 'translateX(-50%)',
          color: 'white',
          textAlign: 'center'
        }}>
          <div style={{ fontSize: '12px', letterSpacing: '2px', marginBottom: '10px' }}>
            SCROLL
          </div>
          <div style={{ fontSize: '20px', animation: 'bounce 2s infinite' }}>↓</div>
        </div>
      </section>

      {/* Models Section */}
      <section id="models" ref={modelsGridRef} style={{
        padding: '100px 40px',
        background: '#0f0f1a'
      }}>
        <h2 className="reveal-text" style={{
          fontSize: '3rem',
          color: 'white',
          textAlign: 'center',
          marginBottom: '60px'
        }}>
          OUR MODELS
        </h2>
        
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))',
          gap: '30px',
          maxWidth: '1200px',
          margin: '0 auto'
        }}>
          {models.map((model) => (
            <div key={model.id} className="model-card" style={{
              background: '#1a1a2e',
              borderRadius: '20px',
              overflow: 'hidden',
              position: 'relative',
              cursor: 'pointer',
              transform: 'translateY(100px)',
              opacity: 0
            }} onClick={() => openPopup(model)}>
              <div style={{
                position: 'relative',
                height: '400px',
                overflow: 'hidden'
              }}>
                <video
                  className="model-video"
                  src={model.video}
                  muted
                  loop
                  style={{
                    width: '100%',
                    height: '100%',
                    objectFit: 'cover',
                    opacity: 0.5,
                    transition: 'opacity 0.5s'
                  }}
                />
                <div style={{
                  position: 'absolute',
                  bottom: '30px',
                  left: '30px',
                  color: 'white',
                  zIndex: 2
                }}>
                  <h3 style={{ fontSize: '2rem', margin: 0 }}>{model.name}</h3>
                  <p style={{ color: model.color, margin: 0 }}>{model.category}</p>
                </div>
              </div>
              
              {/* Interactive Shape */}
              <svg ref={addShapeRef} style={{
                position: 'absolute',
                top: '20px',
                right: '20px',
                width: '40px',
                height: '40px',
                cursor: 'pointer'
              }}>
                <path d="M0,0 L100,0 L100,100 L0,100 Z" fill="white" />
              </svg>
            </div>
          ))}
        </div>
      </section>

      {/* Stats Section */}
      <section className="stats-section" style={{
        padding: '80px 40px',
        background: 'linear-gradient(45deg, #0a0a14, #1a1a2e)',
        color: 'white',
        textAlign: 'center'
      }}>
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
          gap: '40px',
          maxWidth: '1200px',
          margin: '0 auto'
        }}>
          {[
            { value: 150, label: 'Models Worldwide' },
            { value: 500, label: 'Campaigns' },
            { value: 50, label: 'Countries' },
            { value: 25, label: 'Years Excellence' }
          ].map((stat, i) => (
            <div key={i} style={{ padding: '20px' }}>
              <div className="stat-number" data-value={stat.value} style={{
                fontSize: '3rem',
                fontWeight: 'bold',
                color: models[i].color,
                marginBottom: '10px'
              }}>
                0
              </div>
              <div style={{ fontSize: '14px', letterSpacing: '1px' }}>
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* About Section */}
      <section id="about" style={{
        padding: '100px 40px',
        background: '#0f0f1a',
        color: 'white'
      }}>
        <div style={{
          maxWidth: '800px',
          margin: '0 auto',
          textAlign: 'center'
        }}>
          <h2 className="reveal-text" style={{ fontSize: '3rem', marginBottom: '40px' }}>
            ELEVATE YOUR BRAND
          </h2>
          <p className="reveal-text" style={{
            fontSize: '1.2rem',
            lineHeight: '1.8',
            color: 'rgba(255, 255, 255, 0.7)',
            marginBottom: '40px'
          }}>
            We connect exceptional talent with prestigious brands. Our models redefine 
            beauty standards while our professional team ensures every collaboration 
            exceeds expectations.
          </p>
        </div>
      </section>

      {/* Contact Section */}
      <section id="contact" ref={contactFormRef} style={{
        padding: '100px 40px',
        background: '#1a1a2e',
        color: 'white'
      }}>
        <div style={{
          maxWidth: '600px',
          margin: '0 auto',
          textAlign: 'center'
        }}>
          <h2 className="reveal-text" style={{ fontSize: '3rem', marginBottom: '40px' }}>
            GET IN TOUCH
          </h2>
          
          <form style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
            <input type="text" placeholder="Name" style={{
              padding: '15px',
              background: 'rgba(255, 255, 255, 0.1)',
              border: 'none',
              borderRadius: '10px',
              color: 'white',
              fontSize: '16px'
            }} />
            
            <input type="email" placeholder="Email" style={{
              padding: '15px',
              background: 'rgba(255, 255, 255, 0.1)',
              border: 'none',
              borderRadius: '10px',
              color: 'white',
              fontSize: '16px'
            }} />
            
            <textarea placeholder="Message" rows="5" style={{
              padding: '15px',
              background: 'rgba(255, 255, 255, 0.1)',
              border: 'none',
              borderRadius: '10px',
              color: 'white',
              fontSize: '16px',
              resize: 'vertical'
            }} />
            
            <button type="submit" style={{
              padding: '15px 40px',
              background: 'linear-gradient(45deg, #FF6B8B, #4ECDC4)',
              border: 'none',
              color: 'white',
              fontSize: '16px',
              fontWeight: 'bold',
              borderRadius: '30px',
              cursor: 'pointer'
            }}>
              SEND MESSAGE
            </button>
          </form>
        </div>
      </section>

      {/* Footer */}
      <footer style={{
        padding: '40px',
        background: '#0a0a14',
        color: 'rgba(255, 255, 255, 0.5)',
        textAlign: 'center',
        fontSize: '14px'
      }}>
        <div style={{ marginBottom: '20px' }}>
          {['Instagram', 'Twitter', 'LinkedIn', 'Vimeo'].map((social, i) => (
            <a key={i} href="#" style={{
              color: 'white',
              margin: '0 15px',
              textDecoration: 'none',
              fontSize: '12px',
              letterSpacing: '1px'
            }}>
              {social}
            </a>
          ))}
        </div>
        <p>© 2024 ELEVATE Model Management. All rights reserved.</p>
      </footer>

      {/* Model Popup */}
      {isPopupOpen && activeModel && (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: 'rgba(0, 0, 0, 0.8)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 1000,
          backdropFilter: 'blur(10px)'
        }} onClick={closePopup}>
          <div ref={popupRef} onClick={(e) => e.stopPropagation()} style={{
            background: '#1a1a2e',
            borderRadius: '20px',
            padding: '40px',
            maxWidth: '800px',
            width: '90%',
            color: 'white',
            position: 'relative'
          }}>
            <button onClick={closePopup} style={{
              position: 'absolute',
              top: '20px',
              right: '20px',
              background: 'none',
              border: 'none',
              color: 'white',
              fontSize: '24px',
              cursor: 'pointer'
            }}>
              ✕
            </button>
            
            <div style={{ display: 'flex', gap: '40px', alignItems: 'center' }}>
              <div style={{ flex: 1 }}>
                <video
                  src={activeModel.video}
                  autoPlay
                  muted
                  loop
                  style={{
                    width: '100%',
                    borderRadius: '10px',
                    boxShadow: `0 20px 40px ${activeModel.color}30`
                  }}
                />
              </div>
              
              <div style={{ flex: 1 }}>
                <h2 style={{ fontSize: '3rem', marginBottom: '10px', color: activeModel.color }}>
                  {activeModel.name}
                </h2>
                <p style={{ color: activeModel.color, fontSize: '1.2rem', marginBottom: '20px' }}>
                  {activeModel.category}
                </p>
                <p style={{ lineHeight: '1.6', marginBottom: '30px' }}>
